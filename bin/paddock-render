#!/usr/bin/env bash
# paddock:fixed
# paddock 자산을 대상 레포 트리로 렌더하고(render), 대상에 들인다(apply). 규약의 원본은 assets/README.md
#
#   paddock-render render --config <config.sh> --out <빈 폴더>
#       assets/ 를 config 의 변수·모듈·harness 로 렌더해 <빈 폴더> 에 대상 레포 모양 그대로 쓴다.
#       LLM 판단 없음 — 같은 입력이면 같은 출력. 설계 슬롯은 마커째 남긴다(채우는 것은 adopt).
#       <폴더>/.paddock/ 에 config.sh 사본과 manifest.tsv(렌더한 항목의 경로 · 종류 · 해시)를 둔다.
#   paddock-render apply <렌더 폴더> <대상 레포> [--dry-run]
#       렌더 결과를 대상에 들인다. 없는 파일은 만들고, 같은 파일은 건너뛰고, seed 는 이미 있으면 두고,
#       내용이 다른 기존 파일은 「충돌」 로 적고 아무것도 쓰지 않는다(exit 3). gitignore.fragment 는 .gitignore 에 덧붙인다.
#       .paddock/config.sh 와 manifest.tsv 는 paddock 의 상태라 늘 덮어쓴다.
#   paddock-render sync <렌더 폴더> <대상 레포> [--dry-run] [--take-new <경로>]… [--allow-downgrade]
#       이미 들인 대상을 새 렌더(새 버전 또는 바뀐 config)로 맞춘다. 대상 manifest 해시가 「지난 렌더」다 —
#       고정부가 지난 해시와 같으면 새 것으로 바꾸고(설계 슬롯 내용은 ID·순번으로 옮겨 담음), 빠진 파일은 지운다.
#       프로젝트가 고친 고정부·내용이 남은 고아 슬롯·자리를 차지한 기존 파일은 「충돌」 — 하나라도 있으면 아무것도 쓰지 않는다(exit 3).
#       --take-new <경로>: 그 경로의 충돌은 프로젝트 쪽을 버리고 새 것으로 (사용자가 고른 경로만). seed 는 쓰지 않는다.
#       쓰다가 실패하면 lock(.paddock/manifest·config)을 바꾸지 않고 exit 1 — 원인을 고쳐 다시 돌리면 이어진다.
#       새 렌더 버전이 대상보다 낮으면 거절한다(--allow-downgrade 로만).
#   paddock-render version
#       이 플러그인의 버전 (.claude-plugin/plugin.json)
#
# config.sh: PADDOCK_MODULES("l1 l2 bundle" 처럼 켠 모듈) · PADDOCK_HARNESS(bare|corral) · PADDOCK_SKIP(깔지 않을 경로) · 자산 변수들.
#   PADDOCK_VERSION 은 render 가 플러그인 버전으로 쓴다 — config 의 값은 지난 렌더의 버전일 뿐이다.
# 종료코드: 0 성공 · 1 sync 쓰기 일부 실패 · 2 사용법/입력 오류 · 3 apply·sync 충돌 · 4 렌더 실패(미정의 변수·마커 오류)
set -u

PLUGIN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
ASSETS="$PLUGIN_ROOT/assets"
TAB=$(printf '\t')
die() { echo "paddock-render: $1" >&2; exit "${2:-2}"; }
sha() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-64; else sha256sum | cut -c1-64; fi; }
has_word() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }
# PADDOCK_SKIP(공백으로 나눈 경로들) 이거나 그 아래면 렌더하지 않는다 — 프로젝트가 깔지 않기로 한 항목. sync 도 같은 config 로 렌더해 이 결정이 이어진다
skipped() { local p; for p in ${PADDOCK_SKIP:-}; do case "$1" in "$p"|"$p"/*) return 0 ;; esac; done; return 1; }
# a < b 인가 (점으로 나눈 숫자 비교, 접미 -… 는 무시). 둘 중 하나가 비면 거짓
version_lt() { [ -n "$1" ] && [ -n "$2" ] && awk -v a="${1%%-*}" -v b="${2%%-*}" 'BEGIN { n = split(a, x, "."); m = split(b, y, "."); for (i = 1; i <= (n > m ? n : m); i++) { if (x[i] + 0 < y[i] + 0) exit 0; if (x[i] + 0 > y[i] + 0) exit 1 } exit 1 }'; }
plugin_version() { sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -n 1; }

# 파일 종류: 첫 두 줄의 paddock:fixed / paddock:seed, 아니면 design 마커가 있으면 managed, 아니면 fixed
kind_of() {
  if head -n 2 "$1" | grep -q 'paddock:seed'; then echo seed
  elif head -n 2 "$1" | grep -q 'paddock:fixed'; then echo fixed
  elif grep -q '<!-- paddock:design ' "$1"; then echo managed
  else echo fixed; fi
}

# 렌더한 내용의 해시. managed 는 설계 슬롯 안을 비우고 잰다 — 슬롯은 프로젝트 몫이라 drift 로 세지 않는다
content_hash() {
  if [ "$2" = managed ]; then
    awk '/<!-- paddock:design /{print; skip=1; next} /<!-- \/paddock:design -->/{skip=0} !skip' "$1" | sha
  else sha < "$1"; fi
}

render_file() { # $1 원본 $2 출력
  awk -v mods=" $PADDOCK_MODULES " '
    function fail(msg) { printf "%s:%d %s\n", FILENAME, FNR, msg > "/dev/stderr"; bad = 1 }
    /<!-- paddock:module [^ ]+ -->/ {
      if (inmod) fail("module 구간이 닫히기 전에 다시 열림")
      name = $0; sub(/.*<!-- paddock:module /, "", name); sub(/ -->.*/, "", name)
      inmod = 1; on = index(mods, " " name " ") > 0; next
    }
    /<!-- \/paddock:module -->/ { if (!inmod) fail("열리지 않은 module 을 닫음"); inmod = 0; next }
    inmod && !on { next }
    {
      line = $0; out = ""
      while (match(line, /\{\{[A-Z][A-Z0-9_]*\}\}/)) {
        var = substr(line, RSTART + 2, RLENGTH - 4)
        if (!(("PADDOCK_V_" var) in ENVIRON)) { fail("미정의 변수 {{" var "}}"); val = "{{" var "}}" }
        else val = ENVIRON["PADDOCK_V_" var]
        out = out substr(line, 1, RSTART - 1) val
        line = substr(line, RSTART + RLENGTH)
      }
      print out line
    }
    END { if (inmod) fail("끝까지 module 이 안 닫힘"); exit bad }
  ' "$1" > "$2"
}

cmd_render() {
  local config="" out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --config) [ $# -ge 2 ] || die "render: --config 값이 없다"; config=$2; shift 2 ;;
      --out) [ $# -ge 2 ] || die "render: --out 값이 없다"; out=$2; shift 2 ;;
      *) die "render: 모르는 인자 $1" ;;
    esac
  done
  [ -f "$config" ] || die "render: --config 파일이 없다: $config"
  [ -n "$out" ] || die "render: --out 이 필요하다"
  if [ -e "$out" ] && [ -n "$(ls -A "$out" 2>/dev/null)" ]; then die "render: --out 은 비어 있어야 한다: $out"; fi

  # config 를 읽고, 자산이 쓰는 변수를 PADDOCK_V_<이름> 으로 내보낸다 (config 에 있는 것만 — 없으면 렌더 실패)
  # shellcheck disable=SC1090
  . "$config" || die "render: config 를 읽지 못했다: $config"
  : "${PADDOCK_MODULES=}" "${PADDOCK_HARNESS=}" "${PADDOCK_SKIP=}"
  # PADDOCK_SKIP 정규화 — 레포 상대 경로만(앞 ./ 와 끝 / 는 떼고), 절대 경로·..·글롭은 거절
  local skip_in=$PADDOCK_SKIP s; PADDOCK_SKIP=""
  set -f
  for s in $skip_in; do
    s=${s#./}; s=${s%/}
    case "$s" in ""|/*|..|../*|*/..|*/../*|*[\*\?\[]*) set +f; die "render: PADDOCK_SKIP 에 쓸 수 없는 경로: $s — 레포 상대 경로로, .. 과 글롭 없이" ;; esac # guard:r-skip
    PADDOCK_SKIP="$PADDOCK_SKIP $s"
  done
  set +f
  PADDOCK_VERSION=$(plugin_version)
  [ -n "$PADDOCK_VERSION" ] || die "render: 플러그인 버전을 읽지 못했다: $PLUGIN_ROOT/.claude-plugin/plugin.json"
  # 파생 변수 — config 에 두지 않는다. ISSUE_PREFIX 로 정해진다(빈 값 = ID 없음 모드: 작업 이름 = 슬러그)
  if [ -n "${ISSUE_PREFIX+x}" ]; then
    if [ -n "$ISSUE_PREFIX" ]; then
      TASK_NAME="$ISSUE_PREFIX-NNN-<슬러그>" TASK_REF="$ISSUE_PREFIX-NNN" BUNDLE_NAME="$ISSUE_PREFIX-MMM-<슬러그>" BUNDLE_REF="$ISSUE_PREFIX-MMM"
    else
      TASK_NAME="<슬러그>" TASK_REF="<슬러그>" BUNDLE_NAME="<묶음 슬러그>" BUNDLE_REF="<묶음 슬러그>"
    fi
  fi
  local v
  for v in $(cd "$ASSETS" && find . -type f ! -name .gitkeep ! -path ./README.md -print0 | xargs -0 grep -ohE '\{\{[A-Z][A-Z0-9_]*\}\}' | tr -d '{}' | sort -u); do
    if [ -n "${!v+x}" ]; then export "PADDOCK_V_$v=${!v}"; fi
  done
  export PADDOCK_MODULES

  # 렌더할 층: l0 항상, 켠 모듈마다 assets/<모듈>/ 이 있으면 그 폴더(파일 전체가 모듈에 딸린 것),
  # l2 는 공통(common) + 쓰는 도구 하나
  local layers="l0" m
  for m in $PADDOCK_MODULES; do
    case "$m" in l0|l2) continue ;; esac
    [ -d "$ASSETS/$m" ] && layers="$layers $m"
  done
  if has_word "$PADDOCK_MODULES" l2 && ! has_word "$PADDOCK_MODULES" l1; then die "render: l2 는 l1 을 전제한다 — 능력 계약이 l1 절차 문서의 능력 사용을 검사한다"; fi
  if has_word "$PADDOCK_MODULES" l2; then
    [ -n "$PADDOCK_HARNESS" ] || die "render: l2 를 켰는데 PADDOCK_HARNESS 가 비었다"
    [ -d "$ASSETS/l2/$PADDOCK_HARNESS" ] || die "render: 모르는 harness: $PADDOCK_HARNESS"
    layers="$layers l2/common l2/$PADDOCK_HARNESS"
  fi

  mkdir -p "$out/.paddock" || die "render: --out 을 만들지 못했다"
  out=$(cd "$out" && pwd) # 절대 경로로 — awk 는 「이름=값」 꼴 인자를 변수 대입으로 읽는다
  { echo "PADDOCK_VERSION=$PADDOCK_VERSION"; grep -v '^PADDOCK_VERSION=' "$config"; } > "$out/.paddock/config.sh"
  local manifest="$out/.paddock/manifest.tsv" failed=0 layer src rel dst kind
  printf '# paddock %s manifest — 경로\t종류\t해시\n' "$PADDOCK_VERSION" > "$manifest.tmp"
  for layer in $layers; do
    [ -d "$ASSETS/$layer" ] || continue
    while IFS= read -r rel; do
      skipped "$rel" && continue
      src="$ASSETS/$layer/$rel"; dst="$out/$rel"
      if [ -L "$src" ]; then
        mkdir -p "$(dirname "$dst")"; ln -s "$(readlink "$src")" "$dst"
        printf '%s\tlink\t%s\n' "$rel" "$(readlink "$src")" >> "$manifest.tmp"
      elif [ "$(basename "$rel")" = .gitkeep ]; then
        mkdir -p "$(dirname "$dst")"
        printf '%s\tdir\t-\n' "$(dirname "$rel")" >> "$manifest.tmp"
      else
        [ -e "$dst" ] && { echo "paddock-render: 두 층이 같은 경로를 낸다: $rel" >&2; failed=1; continue; }
        mkdir -p "$(dirname "$dst")"
        render_file "$src" "$dst" || failed=1
        [ -x "$src" ] && chmod +x "$dst"
        kind=$(kind_of "$dst")
        printf '%s\t%s\t%s\n' "$rel" "$kind" "$(content_hash "$dst" "$kind")" >> "$manifest.tmp"
      fi
    done < <(cd "$ASSETS/$layer" && find . \( -type f -o -type l \) | sed 's|^\./||' | LC_ALL=C sort)
  done
  [ "$failed" = 0 ] || { rm -rf "$out"; die "render 실패 — 위 오류를 고친 뒤 다시" 4; }
  { head -n 1 "$manifest.tmp"; tail -n +2 "$manifest.tmp" | LC_ALL=C sort -u; } > "$manifest"; rm -f "$manifest.tmp"
  echo "렌더: $(tail -n +2 "$manifest" | wc -l | tr -d ' ')개 항목 → $out (층: $layers)"
}

gitignore_append() { # $1 조각 $2 대상 — 이미 있는 줄은 다시 넣지 않는다
  touch "$2/.gitignore"
  # 끝 개행이 없는 기존 .gitignore 에 덧붙이면 마지막 줄과 붙는다 — 먼저 개행
  if [ -s "$2/.gitignore" ] && [ -n "$(tail -c 1 "$2/.gitignore")" ]; then printf '\n' >> "$2/.gitignore"; fi
  grep -vE '^(#|$)' "$1" | while IFS= read -r line; do grep -qxF "$line" "$2/.gitignore" || printf '%s\n' "$line" >> "$2/.gitignore"; done
}

cmd_apply() {
  local stage=${1:-} target=${2:-} dry=0
  [ "${3:-}" = --dry-run ] && dry=1
  [ -f "$stage/.paddock/manifest.tsv" ] || die "apply: 렌더 폴더가 아니다(.paddock/manifest.tsv 없음): $stage"
  [ -d "$target" ] || die "apply: 대상이 없다: $target"
  local rel kind h conflicts="" created=0 same=0 kept=0 path
  # 1차: 충돌만 모은다 — 하나라도 있으면 아무것도 쓰지 않는다
  while IFS="$(printf '\t')" read -r rel kind h; do
    case "$rel" in '#'*|'') continue ;; esac
    path="$target/$rel"
    case "$kind" in
      dir) [ -e "$path" ] && [ ! -d "$path" ] && conflicts="$conflicts\n  $rel (폴더 자리에 파일이 있다)" ;;
      link) if [ -L "$path" ]; then [ "$(readlink "$path")" = "$h" ] || conflicts="$conflicts\n  $rel (다른 곳을 가리키는 심링크)";
            elif [ -e "$path" ]; then conflicts="$conflicts\n  $rel (심링크 자리에 실제 파일·폴더가 있다)"; fi ;;
      seed) : ;;
      *) [ "$rel" = gitignore.fragment ] && continue
         [ -e "$path" ] && ! cmp -s "$stage/$rel" "$path" && conflicts="$conflicts\n  $rel (내용이 다른 기존 파일)" ;;
    esac
  done < "$stage/.paddock/manifest.tsv"
  if [ -n "$conflicts" ]; then printf '충돌 — 아무것도 쓰지 않았다:%b\n' "$conflicts"; exit 3; fi
  [ "$dry" = 1 ] && { echo "dry-run: 충돌 없음"; exit 0; }
  # 2차: 쓴다
  while IFS="$(printf '\t')" read -r rel kind h; do
    case "$rel" in '#'*|'') continue ;; esac
    path="$target/$rel"
    case "$kind" in
      dir) mkdir -p "$path" ;;
      link) [ -L "$path" ] && { same=$((same+1)); continue; }; mkdir -p "$(dirname "$path")"; ln -s "$h" "$path"; created=$((created+1)) ;;
      *) if [ "$rel" = gitignore.fragment ]; then gitignore_append "$stage/$rel" "$target"; continue; fi
         if [ -e "$path" ]; then if [ "$kind" = seed ] && ! cmp -s "$stage/$rel" "$path"; then kept=$((kept+1)); else same=$((same+1)); fi; continue; fi
         mkdir -p "$(dirname "$path")"; cp -p "$stage/$rel" "$path"; created=$((created+1)) ;;
    esac
  done < "$stage/.paddock/manifest.tsv"
  mkdir -p "$target/.paddock" && cp "$stage/.paddock/manifest.tsv" "$stage/.paddock/config.sh" "$target/.paddock/"
  echo "apply: 새로 $created · 같아서 건너뜀 $same · seed 보존 $kept → $target"
}

# 설계 슬롯을 ID·순번(같은 ID 의 몇 번째)으로 짝짓는다. $1 대상 지금 파일 $2 새 렌더 파일(없으면 /dev/null)
# stdout = 새 렌더에 대상의 채운 슬롯 내용을 옮겨 담은 것. $3 에 고아(대상에 채웠는데 새 쪽에 없는 슬롯), $4 에 새 슬롯(대상에 없던 것)
slot_merge() {
  awk -v orphans="$3" -v fresh="$4" '
    # 주석(여러 줄 포함)을 걷어 낸 뒤에도 글자가 남으면 채운 것
    function filled(s,   out, a, e) {
      out = ""
      while (s != "") {
        a = index(s, "<!--"); if (!a) { out = out s; break }
        out = out substr(s, 1, a - 1); s = substr(s, a + 4)
        e = index(s, "-->"); if (!e) break
        s = substr(s, e + 3)
      }
      gsub(/[ \t\n]/, "", out); return out != ""
    }
    function id_of(line,   id) { id = line; sub(/.*<!-- paddock:design /, "", id); sub(/ -->.*/, "", id); return id }
    FILENAME == ARGV[1] {
      if ($0 ~ /<!-- paddock:design [^ ]+ -->/) { k = id_of($0) "#" (++tn[id_of($0)]); ins = 1; b = ""; next }
      if ($0 ~ /<!-- \/paddock:design -->/) { if (ins) { tb[k] = b; has[k] = 1 } ins = 0; next }
      if (ins) b = b $0 "\n"
      next
    }
    {
      if ($0 ~ /<!-- paddock:design [^ ]+ -->/) { print; k = id_of($0) "#" (++nn[id_of($0)]); ins = 1; nb = ""; next }
      if ($0 ~ /<!-- \/paddock:design -->/) {
        if ((k in has) && filled(tb[k])) printf "%s", tb[k] # guard:s-slot-keep
        else { printf "%s", nb; if (!(k in has)) print k > fresh }
        used[k] = 1; ins = 0; print; next
      }
      if (ins) { nb = nb $0 "\n"; next }
      print
    }
    END { for (k in has) if (!(k in used) && filled(tb[k])) print k > orphans }
  ' "$1" "$2"
}

cmd_sync() {
  local stage="" target="" dry=0 take="" downgrade=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --take-new) [ $# -ge 2 ] || die "sync: --take-new 값이 없다"; take="$take$2
"; shift 2 ;;
      --allow-downgrade) downgrade=1; shift ;;
      -*) die "sync: 모르는 인자 $1" ;;
      *) if [ -z "$stage" ]; then stage=$1; elif [ -z "$target" ]; then target=$1; else die "sync: 인자가 많다: $1"; fi; shift ;;
    esac
  done
  [ -f "$stage/.paddock/manifest.tsv" ] || die "sync: 렌더 폴더가 아니다(.paddock/manifest.tsv 없음): $stage"
  [ -f "$target/.paddock/manifest.tsv" ] || die "sync: 대상에 .paddock/manifest.tsv 가 없다 — 처음 들이는 것은 apply"
  # 절대 경로로 — awk 는 「이름=값」 꼴 인자를 파일이 아니라 변수 대입으로 읽는다
  stage=$(cd "$stage" && pwd) target=$(cd "$target" && pwd)
  local v_old v_new
  v_old=$(sed -n 's/^PADDOCK_VERSION=//p' "$target/.paddock/config.sh" 2>/dev/null | head -n 1)
  v_new=$(sed -n 's/^PADDOCK_VERSION=//p' "$stage/.paddock/config.sh" | head -n 1)
  if [ "$downgrade" = 0 ] && version_lt "$v_new" "$v_old"; then die "sync: 새 렌더($v_new)가 대상($v_old)보다 낮다 — 플러그인을 갱신하거나, 내리려는 것이면 --allow-downgrade"; fi # guard:s-downgrade
  # 전역 — EXIT trap 은 함수가 끝난 뒤에 돈다
  W=$(mktemp -d "${TMPDIR:-/tmp}/paddock-sync.XXXXXX") || die "sync: 임시 폴더를 만들지 못했다"
  trap 'rm -rf "$W"' EXIT
  : > "$W/plan"

  # 지난(대상) manifest 와 새 manifest 를 경로로 합친다: 경로 · 지난 종류 · 지난 해시 · 새 종류 · 새 해시 (없으면 -)
  awk -F'\t' -v OFS='\t' '
    /^#/ || NF < 3 { next }
    FILENAME == ARGV[1] { ok[$1] = $2; oh[$1] = $3; seen[$1] = 1; next }
    { nk[$1] = $2; nh[$1] = $3; seen[$1] = 1 }
    END { for (r in seen) print r, ((r in ok) ? ok[r] : "-"), ((r in ok) ? oh[r] : "-"), ((r in nk) ? nk[r] : "-"), ((r in nk) ? nh[r] : "-") }
  ' "$target/.paddock/manifest.tsv" "$stage/.paddock/manifest.tsv" | LC_ALL=C sort > "$W/union"
  # manifest 경로는 레포 안 상대 경로뿐이다 — 대상 밖을 지우거나 쓰지 않는다
  local bad_paths; bad_paths=$(cut -f1 "$W/union" | grep -E '^/|(^|/)\.\.(/|$)')
  [ -z "$bad_paths" ] || die "sync: manifest 에 레포 밖을 가리키는 경로가 있다: $(echo "$bad_paths" | tr '\n' ' ')" # guard:s-outside

  plan() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$W/plan"; }
  taken() { printf '%s' "$take" | grep -qxF -- "$1"; }
  conflict() { if taken "$1"; then plan "$2" "$1" "$3 (--take-new)"; else plan 충돌 "$1" "$3"; fi; }
  local rel ok oh nk nh path new orph fresh cur why
  while IFS="$TAB" read -r rel ok oh nk nh; do
    path="$target/$rel"
    [ "$rel" = gitignore.fragment ] && continue
    case "$nk" in
      dir) if [ -e "$path" ] && [ ! -d "$path" ]; then plan 충돌 "$rel" "폴더 자리에 파일이 있다"
           elif [ ! -d "$path" ]; then plan "폴더 만듦" "$rel" "새 폴더"; fi ;;
      link) if [ -L "$path" ]; then
              cur=$(readlink "$path")
              if [ "$cur" = "$nh" ]; then :
              elif [ "$ok" = link ] && [ "$cur" = "$oh" ]; then plan 링크 "$rel" "링크 대상 갱신" # guard:s-link3
              else conflict "$rel" 링크 "다른 곳을 가리키는 심링크"; fi
            elif [ -e "$path" ]; then plan 충돌 "$rel" "심링크 자리에 실제 파일·폴더가 있다" # guard:s-link
            else plan 링크 "$rel" "새 심링크"; fi ;;
      seed) if [ ! -e "$path" ] && [ ! -L "$path" ]; then plan 만듦 "$rel" "seed (대상에 없음)"; mkdir -p "$W/new/$(dirname "$rel")"; cp -p "$stage/$rel" "$W/new/$rel"
            elif [ "$ok" = seed ] && [ "$oh" != "$nh" ]; then plan "seed 바뀜" "$rel" "새 버전 seed 가 다르다 — 대상 파일은 그대로, 재감사"; fi ;;
      fixed|managed)
        if [ -L "$path" ] || [ -d "$path" ]; then plan 충돌 "$rel" "파일 자리에 심링크·폴더가 있다"; continue; fi
        mkdir -p "$W/new/$(dirname "$rel")"; new="$W/new/$rel"; orph="$W/orph"; fresh="$W/fresh"; : > "$orph"; : > "$fresh"
        if [ ! -e "$path" ]; then
          cp -p "$stage/$rel" "$new"
          [ "$nk" = managed ] && slot_merge /dev/null "$stage/$rel" /dev/null "$fresh" > /dev/null
          if [ "$ok" = - ]; then plan 만듦 "$rel" "새 파일"; else conflict "$rel" 만듦 "대상에서 지워졌다"; fi # guard:s-missing
        else
          if [ "$nk" = managed ]; then slot_merge "$path" "$stage/$rel" "$orph" "$fresh" > "$new"
          else cp -p "$stage/$rel" "$new"; slot_merge "$path" /dev/null "$orph" /dev/null > /dev/null; fi
          cmp -s "$new" "$path" && continue
          # 사유는 모두 모은다 — 하나만 보이면 --take-new 가 보이지 않은 수정까지 버린다
          why=""
          [ -s "$orph" ] && why="$why + 고아 슬롯(대상에 채웠는데 새 렌더에 자리가 없다: $(sort "$orph" | tr '\n' ' ' | sed 's/ $//'))" # guard:s-orphan
          if [ "$ok" = - ]; then why="$why + 내용이 다른 기존 파일" # guard:s-exists
          elif [ "$(content_hash "$path" "$ok")" != "$oh" ]; then why="$why + 고정부를 프로젝트가 고쳤다"; fi # guard:s-touched
          if [ -n "$why" ]; then conflict "$rel" 갱신 "${why# + }"; else plan 갱신 "$rel" "고정부 갱신"; fi
        fi
        if [ -s "$fresh" ] && ! grep -q "^충돌	$rel	" "$W/plan"; then plan "새 슬롯" "$rel" "$(sort "$fresh" | tr '\n' ' ')— 비어 있음, 재감사가 채운다"; fi ;;
      -) # 새 렌더에서 빠짐 — 지난 그대로면 지운다
        case "$ok" in
          dir) [ -d "$path" ] && plan "폴더 지움" "$rel" "비어 있으면" ;;
          link) if [ -L "$path" ] && [ "$(readlink "$path")" = "$oh" ]; then plan "링크 지움" "$rel" "새 구성에 없음"; fi ;;
          seed) [ -e "$path" ] && plan "seed 남김" "$rel" "새 구성에 없음 — 프로젝트 파일로 남긴다" ;;
          *) [ -f "$path" ] && [ ! -L "$path" ] || continue
             : > "$W/orph"; slot_merge "$path" /dev/null "$W/orph" /dev/null > /dev/null
             why=""
             [ -s "$W/orph" ] && why="$why + 고아 슬롯(새 구성에서 빠지는 파일에 채운 내용: $(sort "$W/orph" | tr '\n' ' ' | sed 's/ $//'))" # guard:s-orphan-del
             [ "$(content_hash "$path" "$ok")" = "$oh" ] || why="$why + 새 구성에서 빠지는 파일을 프로젝트가 고쳤다" # guard:s-touched-del
             if [ -n "$why" ]; then conflict "$rel" 지움 "${why# + }"; else plan 지움 "$rel" "새 구성에 없음"; fi ;;
        esac ;;
    esac
  done < "$W/union"

  local n_conf; n_conf=$(grep -c '^충돌	' "$W/plan")
  if [ -s "$W/plan" ]; then sed 's/^/  /' "$W/plan"; else echo "  (바뀔 것 없음)"; fi
  echo "sync: $(cut -f1 "$W/plan" | sort | uniq -c | awk '{printf "%s%s %s", (NR > 1 ? " · " : ""), $2 ($3 != "" ? " " $3 : ""), $1}')"
  if [ "$n_conf" != 0 ]; then echo "충돌 ${n_conf}건 — 아무것도 쓰지 않았다"; exit 3; fi # guard:s-atomic
  [ "$dry" = 1 ] && { echo "dry-run: 충돌 없음 — 쓰지 않았다"; exit 0; }

  # 쓴다 — 지우기 먼저(빈 폴더 정리), 그다음 만들기·갱신. 하나라도 실패하면 lock(manifest·config)을 바꾸지 않는다 —
  # 그래야 다시 돌렸을 때 이미 쓴 파일은 「그대로」, 못 쓴 파일은 다시 「갱신」으로 이어진다
  local act wfail=""
  while IFS="$TAB" read -r act rel why; do
    path="$target/$rel"
    case "$act" in
      지움) rm -f "$path" || wfail="$wfail $rel"; [ "$(dirname "$rel")" = . ] || (cd "$target" && rmdir -p "$(dirname "$rel")" 2>/dev/null) ;;
      "링크 지움") rm -f "$path" || wfail="$wfail $rel" ;;
      "폴더 지움") (cd "$target" && rmdir -p "$rel" 2>/dev/null) ;;
    esac
  done < "$W/plan"
  # 지우며 비운 폴더 정리가 새 manifest 의 빈 폴더까지 지웠을 수 있다 — 다시 세운다
  while IFS= read -r rel; do mkdir -p "$target/$rel" || wfail="$wfail $rel"; done < <(awk -F'\t' '!/^#/ && $2 == "dir" {print $1}' "$stage/.paddock/manifest.tsv") # guard:s-dirs
  while IFS="$TAB" read -r act rel why; do
    path="$target/$rel"
    case "$act" in
      "폴더 만듦") mkdir -p "$path" || wfail="$wfail $rel" ;;
      만듦|갱신)
        { mkdir -p "$(dirname "$path")" && cat "$W/new/$rel" > "$path"; } 2>/dev/null || { wfail="$wfail $rel"; continue; } # guard:s-wfail
        if [ -x "$stage/$rel" ]; then chmod +x "$path"; fi ;;
      링크) { rm -f "$path" && mkdir -p "$(dirname "$path")" && ln -s "$(readlink "$stage/$rel")" "$path"; } || wfail="$wfail $rel" ;;
    esac
  done < "$W/plan"
  if [ -n "$wfail" ]; then
    echo "sync: 일부만 썼다 — 못 쓴 것:$wfail" >&2
    echo "  .paddock/manifest.tsv·config.sh 는 그대로 뒀다. 원인(권한·디스크)을 고친 뒤 같은 명령을 다시 돌리면 이어진다" >&2
    exit 1
  fi
  [ -f "$stage/gitignore.fragment" ] && gitignore_append "$stage/gitignore.fragment" "$target"
  cp "$stage/.paddock/manifest.tsv" "$stage/.paddock/config.sh" "$target/.paddock/"
  echo "sync: 썼다 → $target"
}

case "${1:-}" in
  render) shift; cmd_render "$@" ;;
  apply) shift; cmd_apply "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  version) plugin_version ;;
  *) sed -n '3,25p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
