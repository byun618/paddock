#!/usr/bin/env bash
# paddock:fixed
# paddock 자산을 대상 레포 트리로 렌더하고(render), 대상에 들인다(apply). 규약의 원본은 assets/README.md
#
#   paddock-render render --config <config.sh> --out <빈 폴더>
#       assets/ 를 config 의 변수·모듈·harness 로 렌더해 <빈 폴더> 에 대상 레포 모양 그대로 쓴다.
#       LLM 판단 없음 — 같은 입력이면 같은 출력. 설계 슬롯은 마커째 남긴다(채우는 것은 adopt).
#       <폴더>/.paddock/ 에 config.sh 사본과 manifest.tsv(렌더한 항목의 경로 · 종류 · 해시)를 둔다.
#   paddock-render apply <렌더 폴더> <대상 레포> [--dry-run]
#       렌더 결과를 대상에 들인다. 없는 파일은 만들고, 같은 파일은 건너뛰고, seed 는 이미 있으면 두고,
#       내용이 다른 기존 파일은 「충돌」 로 적고 아무것도 쓰지 않는다(exit 3). gitignore.fragment 는 .gitignore 에 덧붙인다.
#       .paddock/config.sh 와 manifest.tsv 는 paddock 의 상태라 늘 덮어쓴다.
#
# config.sh: PADDOCK_VERSION · PADDOCK_MODULES("l1 l2 bundle" 처럼 켠 모듈) · PADDOCK_HARNESS(bare|corral) · 자산 변수들
# 종료코드: 0 성공 · 2 사용법/입력 오류 · 3 apply 충돌 · 4 렌더 실패(미정의 변수·마커 오류)
set -u

ASSETS=$(cd "$(dirname "$0")/../assets" && pwd)
die() { echo "paddock-render: $1" >&2; exit "${2:-2}"; }
sha() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-64; else sha256sum | cut -c1-64; fi; }
has_word() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }

# 파일 종류: 첫 두 줄의 paddock:fixed / paddock:seed, 아니면 design 마커가 있으면 managed, 아니면 fixed
kind_of() {
  if head -n 2 "$1" | grep -q 'paddock:seed'; then echo seed
  elif head -n 2 "$1" | grep -q 'paddock:fixed'; then echo fixed
  elif grep -q '<!-- paddock:design ' "$1"; then echo managed
  else echo fixed; fi
}

# 렌더한 내용의 해시. managed 는 설계 슬롯 안을 비우고 잰다 — 슬롯은 프로젝트 몫이라 drift 로 세지 않는다
content_hash() {
  if [ "$2" = managed ]; then
    awk '/<!-- paddock:design /{print; skip=1; next} /<!-- \/paddock:design -->/{skip=0} !skip' "$1" | sha
  else sha < "$1"; fi
}

render_file() { # $1 원본 $2 출력
  awk -v mods=" $PADDOCK_MODULES " '
    function fail(msg) { printf "%s:%d %s\n", FILENAME, FNR, msg > "/dev/stderr"; bad = 1 }
    /<!-- paddock:module [^ ]+ -->/ {
      if (inmod) fail("module 구간이 닫히기 전에 다시 열림")
      name = $0; sub(/.*<!-- paddock:module /, "", name); sub(/ -->.*/, "", name)
      inmod = 1; on = index(mods, " " name " ") > 0; next
    }
    /<!-- \/paddock:module -->/ { if (!inmod) fail("열리지 않은 module 을 닫음"); inmod = 0; next }
    inmod && !on { next }
    {
      line = $0; out = ""
      while (match(line, /\{\{[A-Z][A-Z0-9_]*\}\}/)) {
        var = substr(line, RSTART + 2, RLENGTH - 4)
        if (!(("PADDOCK_V_" var) in ENVIRON)) { fail("미정의 변수 {{" var "}}"); val = "{{" var "}}" }
        else val = ENVIRON["PADDOCK_V_" var]
        out = out substr(line, 1, RSTART - 1) val
        line = substr(line, RSTART + RLENGTH)
      }
      print out line
    }
    END { if (inmod) fail("끝까지 module 이 안 닫힘"); exit bad }
  ' "$1" > "$2"
}

cmd_render() {
  local config="" out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --config) config=${2:-}; shift 2 ;;
      --out) out=${2:-}; shift 2 ;;
      *) die "render: 모르는 인자 $1" ;;
    esac
  done
  [ -f "$config" ] || die "render: --config 파일이 없다: $config"
  [ -n "$out" ] || die "render: --out 이 필요하다"
  if [ -e "$out" ] && [ -n "$(ls -A "$out" 2>/dev/null)" ]; then die "render: --out 은 비어 있어야 한다: $out"; fi

  # config 를 읽고, 자산이 쓰는 변수를 PADDOCK_V_<이름> 으로 내보낸다 (config 에 있는 것만 — 없으면 렌더 실패)
  # shellcheck disable=SC1090
  . "$config" || die "render: config 를 읽지 못했다: $config"
  : "${PADDOCK_VERSION:?config 에 PADDOCK_VERSION 이 없다}" "${PADDOCK_MODULES=}" "${PADDOCK_HARNESS=}"
  # 파생 변수 — config 에 두지 않는다. ISSUE_PREFIX 로 정해진다(빈 값 = ID 없음 모드: 작업 이름 = 슬러그)
  if [ -n "${ISSUE_PREFIX+x}" ]; then
    if [ -n "$ISSUE_PREFIX" ]; then
      TASK_NAME="$ISSUE_PREFIX-NNN-<슬러그>" TASK_REF="$ISSUE_PREFIX-NNN" BUNDLE_NAME="$ISSUE_PREFIX-MMM-<슬러그>" BUNDLE_REF="$ISSUE_PREFIX-MMM"
    else
      TASK_NAME="<슬러그>" TASK_REF="<슬러그>" BUNDLE_NAME="<묶음 슬러그>" BUNDLE_REF="<묶음 슬러그>"
    fi
  fi
  local v
  for v in $(cd "$ASSETS" && find . -type f ! -name .gitkeep ! -path ./README.md -print0 | xargs -0 grep -ohE '\{\{[A-Z][A-Z0-9_]*\}\}' | tr -d '{}' | sort -u); do
    if [ -n "${!v+x}" ]; then export "PADDOCK_V_$v=${!v}"; fi
  done
  export PADDOCK_MODULES

  # 렌더할 층: l0 항상, 켠 모듈마다 assets/<모듈>/ 이 있으면 그 폴더(파일 전체가 모듈에 딸린 것),
  # l2 는 공통(common) + 쓰는 도구 하나
  local layers="l0" m
  for m in $PADDOCK_MODULES; do
    case "$m" in l0|l2) continue ;; esac
    [ -d "$ASSETS/$m" ] && layers="$layers $m"
  done
  if has_word "$PADDOCK_MODULES" l2; then
    [ -n "$PADDOCK_HARNESS" ] || die "render: l2 를 켰는데 PADDOCK_HARNESS 가 비었다"
    [ -d "$ASSETS/l2/$PADDOCK_HARNESS" ] || die "render: 모르는 harness: $PADDOCK_HARNESS"
    layers="$layers l2/common l2/$PADDOCK_HARNESS"
  fi

  mkdir -p "$out/.paddock" || die "render: --out 을 만들지 못했다"
  cp "$config" "$out/.paddock/config.sh"
  local manifest="$out/.paddock/manifest.tsv" failed=0 layer src rel dst kind
  printf '# paddock %s manifest — 경로\t종류\t해시\n' "$PADDOCK_VERSION" > "$manifest.tmp"
  for layer in $layers; do
    [ -d "$ASSETS/$layer" ] || continue
    while IFS= read -r rel; do
      src="$ASSETS/$layer/$rel"; dst="$out/$rel"
      if [ -L "$src" ]; then
        mkdir -p "$(dirname "$dst")"; ln -s "$(readlink "$src")" "$dst"
        printf '%s\tlink\t%s\n' "$rel" "$(readlink "$src")" >> "$manifest.tmp"
      elif [ "$(basename "$rel")" = .gitkeep ]; then
        mkdir -p "$(dirname "$dst")"
        printf '%s\tdir\t-\n' "$(dirname "$rel")" >> "$manifest.tmp"
      else
        [ -e "$dst" ] && { echo "paddock-render: 두 층이 같은 경로를 낸다: $rel" >&2; failed=1; continue; }
        mkdir -p "$(dirname "$dst")"
        render_file "$src" "$dst" || failed=1
        [ -x "$src" ] && chmod +x "$dst"
        kind=$(kind_of "$dst")
        printf '%s\t%s\t%s\n' "$rel" "$kind" "$(content_hash "$dst" "$kind")" >> "$manifest.tmp"
      fi
    done < <(cd "$ASSETS/$layer" && find . \( -type f -o -type l \) | sed 's|^\./||' | LC_ALL=C sort)
  done
  [ "$failed" = 0 ] || { rm -rf "$out"; die "render 실패 — 위 오류를 고친 뒤 다시" 4; }
  { head -n 1 "$manifest.tmp"; tail -n +2 "$manifest.tmp" | LC_ALL=C sort -u; } > "$manifest"; rm -f "$manifest.tmp"
  echo "렌더: $(tail -n +2 "$manifest" | wc -l | tr -d ' ')개 항목 → $out (층: $layers)"
}

cmd_apply() {
  local stage=${1:-} target=${2:-} dry=0
  [ "${3:-}" = --dry-run ] && dry=1
  [ -f "$stage/.paddock/manifest.tsv" ] || die "apply: 렌더 폴더가 아니다(.paddock/manifest.tsv 없음): $stage"
  [ -d "$target" ] || die "apply: 대상이 없다: $target"
  local rel kind h conflicts="" created=0 same=0 kept=0 path
  # 1차: 충돌만 모은다 — 하나라도 있으면 아무것도 쓰지 않는다
  while IFS="$(printf '\t')" read -r rel kind h; do
    case "$rel" in '#'*|'') continue ;; esac
    path="$target/$rel"
    case "$kind" in
      dir) [ -e "$path" ] && [ ! -d "$path" ] && conflicts="$conflicts\n  $rel (폴더 자리에 파일이 있다)" ;;
      link) if [ -L "$path" ]; then [ "$(readlink "$path")" = "$h" ] || conflicts="$conflicts\n  $rel (다른 곳을 가리키는 심링크)";
            elif [ -e "$path" ]; then conflicts="$conflicts\n  $rel (심링크 자리에 실제 파일·폴더가 있다)"; fi ;;
      seed) : ;;
      *) [ "$rel" = gitignore.fragment ] && continue
         [ -e "$path" ] && ! cmp -s "$stage/$rel" "$path" && conflicts="$conflicts\n  $rel (내용이 다른 기존 파일)" ;;
    esac
  done < "$stage/.paddock/manifest.tsv"
  if [ -n "$conflicts" ]; then printf '충돌 — 아무것도 쓰지 않았다:%b\n' "$conflicts"; exit 3; fi
  [ "$dry" = 1 ] && { echo "dry-run: 충돌 없음"; exit 0; }
  # 2차: 쓴다
  while IFS="$(printf '\t')" read -r rel kind h; do
    case "$rel" in '#'*|'') continue ;; esac
    path="$target/$rel"
    case "$kind" in
      dir) mkdir -p "$path" ;;
      link) [ -L "$path" ] && { same=$((same+1)); continue; }; mkdir -p "$(dirname "$path")"; ln -s "$h" "$path"; created=$((created+1)) ;;
      *) if [ "$rel" = gitignore.fragment ]; then
           touch "$target/.gitignore"
           grep -vE '^(#|$)' "$stage/$rel" | while IFS= read -r line; do grep -qxF "$line" "$target/.gitignore" || printf '%s\n' "$line" >> "$target/.gitignore"; done
           continue
         fi
         if [ -e "$path" ]; then if [ "$kind" = seed ] && ! cmp -s "$stage/$rel" "$path"; then kept=$((kept+1)); else same=$((same+1)); fi; continue; fi
         mkdir -p "$(dirname "$path")"; cp -p "$stage/$rel" "$path"; created=$((created+1)) ;;
    esac
  done < "$stage/.paddock/manifest.tsv"
  mkdir -p "$target/.paddock" && cp "$stage/.paddock/manifest.tsv" "$stage/.paddock/config.sh" "$target/.paddock/"
  echo "apply: 새로 $created · 같아서 건너뜀 $same · seed 보존 $kept → $target"
}

case "${1:-}" in
  render) shift; cmd_render "$@" ;;
  apply) shift; cmd_apply "$@" ;;
  *) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
